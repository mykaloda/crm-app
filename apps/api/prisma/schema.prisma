generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ======================= identity =======================

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AgeVerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  passwordHash          String?
  role                  Role                  @default(USER)
  status                UserStatus            @default(ACTIVE)
  locale                String                @default("en")
  ageVerificationStatus AgeVerificationStatus @default(NONE)
  ageVerifiedAt         DateTime?
  /// Global AI kill switch. false = no agent (external or built-in) may act for this user.
  aiEnabled             Boolean               @default(true)
  lastActiveAt          DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  identities       AuthIdentity[]
  sessions         Session[]
  consents         Consent[]
  ageVerifications AgeVerification[]
  profile          Profile?
  drafts           ProfileDraft[]
  photos           Photo[]
  connections      AgentConnection[]
  oauthCodes       OAuthAuthCode[]
  oauthTokens      OAuthToken[]
  actionLogs       AgentActionLog[]
  interviews       InterviewSession[]
  matchesA         Match[]            @relation("MatchA")
  matchesB         Match[]            @relation("MatchB")
  sentAgentMsgs    AgentMessage[]     @relation("AgentMsgFrom")
  disclosures      Disclosure[]       @relation("DisclosureFrom")
  receivedDisclose Disclosure[]       @relation("DisclosureTo")
  chatMessages     ChatMessage[]
  feedback         MatchFeedback[]
  reportsMade      Report[]           @relation("ReportBy")
  reportsReceived  Report[]           @relation("ReportAgainst")
  blocksMade       Block[]            @relation("BlockBy")
  blocksReceived   Block[]            @relation("BlockAgainst")
  subscription     Subscription?
  activityDays     UserActivityDay[]
}

model AuthIdentity {
  id             String   @id @default(cuid())
  userId         String
  provider       String // google | apple
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

/// Web session backed by a rotating refresh token (hash stored).
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ConsentType {
  TERMS
  PRIVACY
  SENSITIVE_DATA
  AI_PROCESSING
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  version   String      @default("2026-09")
  grantedAt DateTime    @default(now())
  revokedAt DateTime?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AgeVerification {
  id          String                @id @default(cuid())
  userId      String
  provider    String
  externalId  String                @unique
  status      AgeVerificationStatus @default(PENDING)
  result      Json?
  createdAt   DateTime              @default(now())
  completedAt DateTime?
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserActivityDay {
  userId String
  day    DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

// ======================= profile =======================

enum ProfileStatus {
  INCOMPLETE
  ACTIVE
  PAUSED
}

/// Approved profile. Hard-filter fields are typed columns so matching can filter in SQL.
/// Soft sections live in JSON; the values section is encrypted at field level (valuesEnc).
model Profile {
  userId       String        @id
  status       ProfileStatus @default(INCOMPLETE)
  completeness Int           @default(0)

  // basic (hard filters)
  displayName String?
  birthDate   DateTime? @db.Date
  gender      String?
  seeking     String[]
  ageMin      Int?
  ageMax      Int?
  city        String?
  lat         Float?
  lng         Float?
  radiusKm    Int?

  // goals (hard filters)
  relationshipType String?
  hasChildren      Boolean?
  wantsChildren    String?
  timeline         String?

  // lifestyle (filter + weight)
  smoking    String?
  alcohol    String?
  exercise   String?
  schedule   String?
  pets       String?
  relocation String?

  // soft sections
  personality   Json?
  interestTags  String[]
  interestsText String?
  /// AES-256-GCM ciphertext of the values section JSON
  valuesEnc     String?
  /// { excludeSmoking: [], excludeAlcohol: [], excludePets: [], noPartnerChildren: bool }
  dealBreakers  Json?
  aiDescription String?
  embedding     Unsupported("vector(1536)")?

  /// fieldKey -> hidden | algorithm_only | agents | people
  visibility Json     @default("{}")
  approvedAt DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, gender])
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ChangeSource {
  USER
  AGENT_MCP
  AGENT_GPT
  AGENT_BUILTIN
}

/// Every change proposed by an AI is stored here until the human approves it.
model ProfileDraft {
  id           String       @id @default(cuid())
  userId       String
  source       ChangeSource
  connectionId String?
  /// Sensitive sections are stored encrypted inside the patch (see ProfileCrypto).
  patchEnc     String
  note         String?
  status       DraftStatus  @default(PENDING)
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Photo {
  id         String           @id @default(cuid())
  userId     String
  storageKey String
  mimeType   String
  position   Int
  moderation ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ======================= AI access =======================

enum ConnectionType {
  MCP
  CUSTOM_GPT
  BUILTIN
}

model AgentConnection {
  id         String         @id @default(cuid())
  userId     String
  type       ConnectionType
  clientId   String?
  label      String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       AgentActionLog[]

  @@index([userId])
}

model OAuthClient {
  clientId         String   @id
  clientSecretHash String?
  name             String
  redirectUris     String[]
  /// dynamically registered (RFC 7591) vs pre-registered (Custom GPT)
  dynamic          Boolean  @default(true)
  connectionType   ConnectionType @default(MCP)
  createdAt        DateTime @default(now())
}

model OAuthAuthCode {
  codeHash      String   @id
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  id               String    @id @default(cuid())
  accessTokenHash  String    @unique
  refreshTokenHash String?   @unique
  clientId         String
  userId           String
  connectionId     String
  scope            String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Every tool call by any agent. Visible to the owner.
model AgentActionLog {
  id           String           @id @default(cuid())
  userId       String
  connectionId String?
  tool         String
  input        Json?
  resultSummary String?
  status       String // ok | blocked | error | rate_limited
  reason       String?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   AgentConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model InterviewSession {
  id        String   @id @default(cuid())
  userId    String
  /// [{ role: 'assistant' | 'user', content }]
  messages  Json     @default("[]")
  status    String   @default("active") // active | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ======================= matching =======================

enum MatchStatus {
  CANDIDATE // passed filters + scoring
  NEGOTIATING
  AGENT_MATCHED // both agents said match
  REJECTED // an agent said no_match / out of messages
  MUTUAL // both humans liked
  CLOSED // someone passed, blocked or unmatched
}

enum HumanDecision {
  LIKE
  PASS
}

/// Unordered pair: userAId < userBId (lexicographic). Per-side fields use A/B suffixes.
model Match {
  id          String         @id @default(cuid())
  userAId     String
  userBId     String
  status      MatchStatus    @default(CANDIDATE)
  scoreAB     Float
  scoreBA     Float
  score       Float
  breakdownAB Json?
  breakdownBA Json?
  explanationA String?
  explanationB String?
  presentedAAt DateTime?
  presentedBAt DateTime?
  decisionA   HumanDecision?
  decisionB   HumanDecision?
  mutualAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userA        User           @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User           @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  negotiation  Negotiation?
  chatMessages ChatMessage[]
  feedback     MatchFeedback[]
  disclosures  Disclosure[]

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
  @@index([status])
}

enum NegotiationStatus {
  OPEN
  CONCLUDED
}

model Negotiation {
  id           String            @id @default(cuid())
  matchId      String            @unique
  status       NegotiationStatus @default(OPEN)
  messageCount Int               @default(0)
  verdictA     String? // match | no_match | clarify
  verdictB     String?
  rationaleA   String?
  rationaleB   String?
  outcome      String? // match | no_match
  createdAt    DateTime          @default(now())
  concludedAt  DateTime?
  match        Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages     AgentMessage[]
}

model AgentMessage {
  id            String      @id @default(cuid())
  negotiationId String
  fromUserId    String
  toUserId      String
  kind          String
  content       String
  readAt        DateTime?
  createdAt     DateTime    @default(now())
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  from          User        @relation("AgentMsgFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, readAt])
}

/// Human-approved disclosure of personal fields to a specific other user.
model Disclosure {
  id         String   @id @default(cuid())
  matchId    String
  fromUserId String
  toUserId   String
  fields     String[]
  createdAt  DateTime @default(now())
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  from       User     @relation("DisclosureFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("DisclosureTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId])
}

model MatchFeedback {
  id         String   @id @default(cuid())
  matchId    String
  userId     String
  liked      Boolean?
  chatLength Int?
  met        Boolean?
  rating     Int?
  comment    String?
  createdAt  DateTime @default(now())
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model AlgorithmConfig {
  id        String   @id @default("default")
  config    Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ======================= social =======================

model ChatMessage {
  id        String    @id @default(cuid())
  matchId   String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String
  matchId      String?
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolution   String?
  moderatorId  String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  reporter     User         @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Cascade)
  target       User         @relation("ReportAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockAgainst", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

// ======================= billing =======================

model Subscription {
  userId           String    @id
  provider         String
  externalId       String?
  plan             String    @default("premium")
  status           String // active | canceled | past_due
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
