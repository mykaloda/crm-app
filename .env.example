# Public URL used in emails, certificates and Stripe redirects
SITE_URL=http://localhost:3000

# SQLite file (default: ./data/moment.db)
# DATABASE_PATH=./data/moment.db

# Admin panel password (/admin). In development the default is "admin".
ADMIN_PASSWORD=
ADMIN_EMAIL=
SESSION_SECRET=

# Weather: "simulated" for demos; otherwise OpenWeatherMap (if key) is primary, Open-Meteo confirms.
WEATHER_PROVIDER=
OPENWEATHER_API_KEY=

# Monitoring: protect the cron endpoint; or run the built-in scheduler in a long-lived server.
CRON_SECRET=
INTERNAL_SCHEDULER=1

# Stripe. Without keys the site uses a test payment page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX=0
REFUND_FEE_PERCENT=5

# Email (Resend) and SMS (Twilio). Without keys messages are only logged in the admin panel.
RESEND_API_KEY=
EMAIL_FROM="Moment <hello@example.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Display-only currency rates, e.g. {"EUR":0.86}
DISPLAY_RATES=
