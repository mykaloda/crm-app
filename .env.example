# ---------- core ----------
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentmatch
REDIS_URL=redis://localhost:6379

# Public URLs (what browsers and AI clients see)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
MCP_URL=http://localhost:4100
# URL the MCP server uses to reach the API (docker: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MCP_URL=http://localhost:4100

PORT_API=4000
PORT_MCP=4100

# ---------- secrets (generate: openssl rand -base64 32) ----------
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# 32 bytes, base64. Encrypts sensitive profile fields (values, faith, politics).
FIELD_ENCRYPTION_KEY=ZmllbGQtZW5jcnlwdGlvbi1rZXktMzItYnl0ZXMhISE=
# Shared secret between mcp and api for token introspection
INTERNAL_API_SECRET=change-me-internal-secret
COOKIE_SECURE=false

# ---------- providers (empty = deterministic offline fake) ----------
EMBEDDINGS_PROVIDER=hash            # hash | openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AGENT_LLM_PROVIDER=scripted          # scripted | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

AGE_VERIFICATION_PROVIDER=mock       # mock | veriff | persona (stubs)
VERIFF_API_KEY=
PERSONA_API_KEY=

# Social login. Empty client id = mock provider (dev only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

PAYMENTS_PROVIDER=mock               # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Pre-registered OAuth client for a Custom GPT (ChatGPT Actions)
GPT_OAUTH_CLIENT_ID=agentmatch-custom-gpt
GPT_OAUTH_CLIENT_SECRET=change-me-gpt-client-secret

# ---------- matching ----------
MATCHING_DAILY_CRON=0 3 * * *
MATCHING_ENABLE_SCHEDULER=true
NEGOTIATION_TOP_N=20
NEGOTIATION_MAX_MESSAGES=10

# Rate limits (per user per hour)
RATE_LIMIT_SEARCH_PER_HOUR=30
RATE_LIMIT_AGENT_MESSAGES_PER_HOUR=120

# Bootstrap admin (email gets ADMIN role on registration)
ADMIN_EMAILS=admin@agentmatch.local
