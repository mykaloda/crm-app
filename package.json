{
  "name": "agentmatch",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @agentmatch/api test:e2e && pnpm --filter @agentmatch/mcp test:e2e",
    "db:migrate": "pnpm --filter @agentmatch/api prisma:migrate",
    "db:seed": "pnpm --filter @agentmatch/api seed"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.15.0"
  }
}
